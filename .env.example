# Copy to .env and fill secrets for docker compose.
PPT_MASTER_HOST_PORT=8097

# Auth: keep disabled for now; local-access provides fixed caller context.
PPT_MASTER_SERVICE_AUTH_ENABLED=false
PPT_MASTER_LOCAL_ACCESS_ENABLED=true
PPT_MASTER_LOCAL_ACCESS_SUBJECT_ID=dev
PPT_MASTER_LOCAL_ACCESS_TENANT_ID=dev
PPT_MASTER_LOCAL_ACCESS_ROLES=

# LLM (host litellm / gateway on :4000)
AGENTSCOPE_PROVIDER=openai
AGENTSCOPE_MODEL_NAME=kimi-for-coding
AGENTSCOPE_API_KEY=
AGENTSCOPE_BASE_URL=http://host.docker.internal:4000/v1
AGENTSCOPE_FALLBACKS_0_PROVIDER=openai
AGENTSCOPE_FALLBACKS_0_MODEL_NAME=gemini-3.8-flash
AGENTSCOPE_FALLBACKS_0_API_KEY=
AGENTSCOPE_FALLBACKS_0_BASE_URL=http://host.docker.internal:4000/v1

# Image generation (OpenAI-compatible)
PPT_IMAGE_BASE_URL=
PPT_IMAGE_API_KEY=
PPT_IMAGE_MODEL=gpt-image-2.6-flare
